     Thành công: {"ok": true, "path": ..., "bytes": ..., "status": "created" | "updated"}. Lỗi: {"ok": false, "error": {...}}.
     """
     return json.dumps(_write(paths.WORKSPACE_DIR, path, content), ensure_ascii=False)
+
+
+def _list(workspace: Path, path: str) -> dict:
+    """List direct children only; reject links resolving outside the workspace."""
+    try:
+        target, error = _resolve(workspace, path)
+        if error:
+            return error
+        root = workspace.resolve()
+        rel = target.relative_to(root).as_posix()
+        if not target.exists():
+            return _error("DIRECTORY_NOT_FOUND", f"Không tìm thấy thư mục: {rel}")
+        if not target.is_dir():
+            return _error("NOT_A_DIRECTORY", f"Đường dẫn không phải thư mục: {rel}")
+        entries = []
+        for child in sorted(target.iterdir(), key=lambda p: p.name):
+            # Validate before stat/is_dir: do not inspect an outside link target.
+            resolved, error = _resolve(workspace, child.relative_to(root).as_posix())
+            if error:
+                return error
+            if not resolved.exists():
+                return _error("BROKEN_SYMLINK", f"Liên kết không có đích: {child.name}")
+            if not (resolved.is_dir() or resolved.is_file()):
+                return _error("UNSUPPORTED_ENTRY", f"Mục không phải file/thư mục: {child.name}")
+            entries.append({"name": child.name,
+                            "path": child.relative_to(root).as_posix(),
+                            "type": "directory" if resolved.is_dir() else "file"})
+        return {"ok": True, "path": rel, "entries": entries}
+    except (OSError, RuntimeError, ValueError):
+        return _error("DIRECTORY_ACCESS_ERROR", "Không thể liệt kê thư mục; kiểm tra quyền truy cập và liên kết.")
+
+
+@tool
+def list_files(path: str) -> str:
+    """Liệt kê các mục trực tiếp trong thư mục để tìm file trước khi dùng read_file.
+
+    path tương đối workspace, dùng '.' để liệt kê gốc. Không duyệt đệ quy.
+    Thành công: {ok: true, path: ..., entries: [{name, path, type}]}.
+    type là file hoặc directory; sắp xếp theo name. Chỉ truy cập trong workspace.
+    Lỗi: {ok: false, error: {code, message}}; file/đường dẫn không tồn tại đều là lỗi.
+    """
+    return json.dumps(_list(paths.WORKSPACE_DIR, path), ensure_ascii=False)
